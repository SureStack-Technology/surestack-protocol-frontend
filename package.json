{
  "name": "surestack-protocol-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend dApp for SureStack Protocol – decentralized risk coverage and governance network",
  "author": "SureStack Technology",
  "repository": {
    "type": "git",
    "url": "https://github.com/SureStack-Technology/surestack-protocol-frontend.git"
  },
  "homepage": "https://github.com/SureStack-Technology/surestack-protocol-frontend#readme",
  "bugs": {
    "url": "https://github.com/SureStack-Technology/surestack-protocol-frontend/issues"
  },
  "scripts": {
    "validate:env": "node scripts/check-env.js",
    "dev": "npm run validate:env && vite --port 3000 --clearScreen false",
    "dev:3001": "npm run validate:env && vite --port 3001 --clearScreen false",
    "backend:dev": "npm --prefix backend run dev",
    "dev:skip-env": "vite --port 3000 --clearScreen false",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "test": "npx hardhat test --network localhost",
    "test:all": "npx hardhat test",
    "coverage": "npx hardhat coverage",
    "gas": "REPORT_GAS=true npx hardhat test --network localhost",
    "validate": "node scripts/validate-sepolia.js",
    "sync:env": "node sync-env.js",
    "fix:oracle": "npx hardhat run scripts/fix-oracle-reader.js --network sepolia",
    "post:deploy": "npx hardhat run scripts/post-deploy-setup.js --network sepolia",
    "deploy:policy-manager": "npx hardhat run scripts/deploy-policy-manager.js --network sepolia",
    "deploy:oracle-v2": "npx hardhat run scripts/deploy-oracle-reader-v2.js --network sepolia",
    "deploy:consensus-v2": "npx hardhat run scripts/deploy-consensus-v2.js --network sepolia",
    "deploy:reward-pool-v2": "npx hardhat run scripts/deploy-reward-pool-v2.js --network sepolia",
    "fund:pools": "npx hardhat run scripts/fund-pools.js --network sepolia",
    "setup:validators": "npx hardhat run scripts/setup-validators.js --network sepolia",
    "simulate:revenue": "node scripts/simulate-revenue.js",
    "simulate:events": "npx hardhat run scripts/simulateEvents.js --network sepolia",
    "generate:report": "node scripts/generate-report.js",
    "verify:claim": "npx hardhat run scripts/verify-claim.js --network sepolia",
    "fix:aliases": "node scripts/fix-alias-imports.js",
    "validate:p32": "node scripts/p32LiveValidation.mjs",
    "validate:p33": "node scripts/p33ApiValidation.mjs",
    "validate:p4": "node scripts/p4LaunchReadiness.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.7",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "ethers": "^6.15.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.400.0",
    "next": "14.2.0",
    "orbitron": "^0.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.5",
    "react-tsparticles": "^2.12.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "tsparticles-slim": "^2.12.0",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-ignition": "0.15.15",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.15",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.17",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.0",
    "hardhat-abi-exporter": "^2.11.0",
    "hardhat-gas-reporter": "^2.3.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.33",
    "solidity-coverage": "^0.8.16",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  }
}
